    "# Remove exact duplicate rows\n",
    "apps = apps.drop_duplicates().copy()\n",
    "\n",
    "# Remove duplicate app names, keeping the first record\n",
    "apps = apps.drop_duplicates(subset=\"App\", keep=\"first\").copy()\n",
    "\n",
    "# Numeric conversion\n",
    "apps[\"Rating\"] = pd.to_numeric(apps[\"Rating\"], errors=\"coerce\")\n",
    "apps[\"Reviews\"] = pd.to_numeric(apps[\"Reviews\"], errors=\"coerce\")\n",
    "\n",
    "# Convert Installs: \"10,000+\" -> 10000\n",
    "apps[\"Installs\"] = (\n",
    "    apps[\"Installs\"]\n",
    "    .astype(str)\n",
    "    .str.replace(\",\", \"\", regex=False)\n",
    "    .str.replace(\"+\", \"\", regex=False)\n",
    ")\n",
    "apps[\"Installs\"] = pd.to_numeric(apps[\"Installs\"], errors=\"coerce\")\n",
    "\n",
    "# Convert Price: \"$4.99\" -> 4.99\n",
    "apps[\"Price\"] = (\n",
    "    apps[\"Price\"]\n",
    "    .astype(str)\n",
    "    .str.replace(\"$\", \"\", regex=False)\n",
    ")\n",
    "apps[\"Price\"] = pd.to_numeric(apps[\"Price\"], errors=\"coerce\")\n",
    "\n",
    "# Convert Size\n",
    "def convert_size(value):\n",
    "    if pd.isna(value):\n",
    "        return np.nan\n",
    "    value = str(value).strip()\n",
    "    if value == \"Varies with device\":\n",
    "        return np.nan\n",
    "    if value.endswith(\"M\"):\n",
    "        return float(value[:-1])\n",
    "    if value.endswith(\"k\"):\n",
    "        return float(value[:-1]) / 1024\n",
    "    return np.nan\n",
    "\n",
    "apps[\"Size_MB\"] = apps[\"Size\"].apply(convert_size)\n",
    "\n",
    "# Convert date\n",
    "apps[\"Last Updated\"] = pd.to_datetime(apps[\"Last Updated\"], errors=\"coerce\")\n",
    "apps[\"Day\"] = apps[\"Last Updated\"].dt.day\n",
    "apps[\"Month\"] = apps[\"Last Updated\"].dt.month\n",
    "apps[\"Year\"] = apps[\"Last Updated\"].dt.year\n",
    "\n",
    "# Standardize Type\n",
    "apps[\"Type\"] = apps[\"Type\"].astype(str).str.strip().str.title()\n",
    "\n",
    "print(\"Cleaned shape:\", apps.shape)\n",
    "apps.head()"
   ]
