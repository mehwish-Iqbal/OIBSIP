    "import pandas as pd\n",
    "import plotly.express as px\n",
    "\n",
    "# Remove rows with missing Reviews or Rating\n",
    "plot_df = df.dropna(subset=[\"Reviews\", \"Rating\"]).copy()\n",
    "\n",
    "# Interactive scatter plot\n",
    "fig = px.scatter(\n",
    "    plot_df,\n",
    "    x=\"Reviews\",\n",
    "    y=\"Rating\",\n",
    "    size=\"Reviews\",\n",
    "    color=\"Category\",\n",
    "    hover_name=\"App\",\n",
    "    hover_data=[\"Rating\", \"Reviews\", \"Category\"],\n",
    "    title=\"Interactive: Reviews vs App Rating\",\n",
    "    labels={\n",
    "        \"Reviews\": \"Number of Reviews\",\n",
    "        \"Rating\": \"App Rating\"\n",
    "    }\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    xaxis_type=\"log\"\n",
    ")\n",
    "\n",
    "fig.show()"
